# Local development defaults to the no-cost mock provider.
COMPANION_PROVIDER=mock

# Required only when COMPANION_PROVIDER=deepseek. Never commit a real key.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Per-instance safety limits. See docs/ai-companion-deployment.md.
COMPANION_CHAT_RATE_LIMIT=10
COMPANION_RECOMMENDATION_RATE_LIMIT=60
COMPANION_RATE_LIMIT_WINDOW_MS=60000
